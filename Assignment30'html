    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    <style>
        * { margin:0; padding:0; box-sizing: border-box; }
        :root {
            --primary: #1A237E;
            --accent: #FFC107;
            --bg: #F0F2F5;
            --radius: 18px;
        }
        body { font-family: 'Poppins', sans-serif; background: var(--bg); padding: 20px; }
        header { text-align: center; padding: 20px; }
        h1 { font-family: 'Playfair Display', serif; color: var(--primary); }
        .container { max-width: 1100px; margin: 20px auto; display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }

        /* ===== FINISHED PROFILE CARD ===== */
        .profile-card {
            position: relative; /* For absolute badge */
            background: white;
            border-radius: var(--radius);
            overflow: hidden; /* Fixes overflow - Q28 */
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            width: 100%;
            max-width: 350px;
            margin: 0 auto;
        }
        .profile-banner {
            height: 120px;
            background: linear-gradient(135deg, #1A237E, #3949AB);
            position: relative;
        }
        .profile-badge {
            position: absolute; /* Position used */
            top: 15px; right: 15px;
            background: var(--accent);
            color: #212121;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            z-index: 2; /* Z-Index used */
        }
        .profile-avatar {
            position: absolute; /* Position used */
            bottom: -40px;
            left: 50%;
            transform: translateX(-50%);
            width: 90px; height: 90px;
            border-radius: 50%; /* Border-radius Q27 */
            border: 4px solid white;
            background: url('https://via.placeholder.com/90/FFC107/000?text=NS') center/cover;
            z-index: 3; /* Z-Index used */
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }
        .profile-body {
            padding: 60px 25px 25px; /* Padding - Box Model Q26 */
            text-align: center;
        }
        .profile-body h3 { color: var(--primary); margin-bottom: 5px; }
        .profile-body .role { font-size: 13px; color: #757575; margin-bottom: 15px; }
        .profile-stats { display: flex; justify-content: space-around; border-top: 1px solid #eee; padding-top: 15px; margin-top: 15px; }
        .profile-stats div b { display: block; color: var(--primary); }
        .profile-stats div span { font-size: 11px; color: #999; }
        .btn { display: block; width: 100%; padding: 10px; border-radius: 30px; border: none; background: var(--primary); color: white; font-weight: 600; margin-top: 15px; cursor: pointer; }

        /* ===== FINISHED PRODUCT CARD ===== */
        .product-card {
            position: relative;
            background: white;
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            max-width: 350px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
        }
        .product-img-wrap {
            position: relative;
            height: 200px;
            background: #E8EAF6;
            overflow: hidden;
        }
        .product-img-wrap img {
            width: 100%; height: 100%;
            object-fit: cover;
            max-width: 100%; /* Overflow fix Q28 */
        }
        .discount {
            position: absolute;
            top: 12px; left: 12px;
            background: #D32F2F;
            color: white;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
            z-index: 2;
        }
        .wishlist {
            position: absolute;
            top: 12px; right: 12px;
            width: 36px; height: 36px;
            background: white;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            z-index: 2;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
            cursor: pointer;
        }
        .product-info { padding: 18px; }
        .product-info h3 { font-size: 16px; color: #212121; margin-bottom: 6px; overflow-wrap: break-word; } /* Overflow fix */
        .rating { color: #FFC107; font-size: 13px; }
        .price { margin-top: 10px; display: flex; gap: 10px; align-items: center; }
        .price .new { font-size: 20px; font-weight: 700; color: var(--primary); }
        .price .old { font-size: 13px; color: #999; text-decoration: line-through; }
        .product-btn { background: var(--primary); color: white; border: none; padding: 10px; border-radius: 10px; width: 100%; margin-top: 12px; font-weight: 600; }

        .explain { grid-column: span 2; background: white; padding: 20px; border-radius: 12px; font-size: 13px; line-height: 1.7; }
        footer { text-align: center; padding: 15px; background: #222; color: #aaa; font-size: 12px; margin-top: 20px; border-radius: 10px; }
        @media(max-width:800px){ .container{grid-template-columns:1fr;} .explain{grid-column: span 1;} }
    </style>
</head>
